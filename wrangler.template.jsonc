// =============================================================================
// cf-openlist · **网友自部署专用模板**
// =============================================================================
//
// ## 这是干什么的
//
// 仓库里的 `wrangler.jsonc` 是**作者本人的生产配置**，里面写死了：
//   - 作者自有的域名（routes.custom_domain）
//   - 作者自有账号下的 KV 命名空间 id
//
// 你直接拿那份去部署**必然报错**：你没有那个域名，也访问不到那个 KV。
// 所以自部署请用本文件。
//
// ## 怎么用（三步）
//
// ```bash
// # 1. 克隆你自己的 fork
// git clone https://github.com/<你的用户名>/cf-openlist.git
// cd cf-openlist
//
// # 2. 用本模板覆盖 wrangler.jsonc（覆盖的是本地副本，不影响上游）
// cp wrangler.template.jsonc wrangler.jsonc
//
// # 3. 改两处后部署（见下方 ★ 标记）
// pnpm install --no-frozen-lockfile
// pnpm run build          # 拉取前端 + 构建
// pnpm run deploy:worker
// ```
//
// ★ 需要你改的只有两处：
//   - `"name"`                → 换成你想要的名字（全局唯一即可）
//   - `"kv_namespaces"`       → **删掉整项**（见下方说明，wrangler 会自动创建）
//
// 想绑定自己的域名？再打开 `"routes"` 那一段的注释，把 pattern 换成你的域名。
// 不需要自定义域名就**保持注释状态**，部署完直接用 `*.workers.dev` 访问。
//
// =============================================================================
{
  // ★ 改成你自己的 Worker 名。首次部署会以这个名字创建 Worker 与 KV。
  "name": "cf-openlist",

  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  // 是否开放 `<worker名>.<账号>.workers.dev` 访问。
  // 没有自定义域名的话，这里必须是 true，否则部署完没入口。
  "workers_dev": true,
  "preview_urls": false,

  // ===========================================================================
  // 自定义域名（可选）
  // ===========================================================================
  //
  // 前提：该域名已托管在**你自己的** Cloudflare 账号下的 Zone 里。
  // 如果只是想在 workers.dev 上跑，**保持注释即可**。
  //
  // ⚠️ 部署后再改域名时注意：旧 Worker 的 Route 会残留并抢占 Custom Domain，
  //    表现为 `/api/*` 全部卡死、`wrangler tail` 一条日志都没有。
  //    改域名前先删掉旧的 route（GET /zones/{zone}/workers/routes 拿 id 再 DELETE）。
  //
  // "routes": [{ "pattern": "你的域名.com", "custom_domain": true }],

  // ===========================================================================
  // 定时触发器（Cron Triggers）
  // ===========================================================================
  //
  // 用途：清理 139 CAS 播放产生的临时副本（播完把副本送进回收站）。
  //
  // 为什么必须配：CAS 播放会把真实文件"秒传"还原到云盘 TEMP 目录，播完需删。
  // Workers 上"播完即删"不可靠 —— ctx.waitUntil 只保证约 30 秒，而清理延迟
  // 是 120 秒，且 isolate 随时会被回收。所以兜底只能靠定时任务。
  //
  // ⚠️ 不配这一项，`scheduled()` 永不执行，TEMP 会持续堆积。
  //
  // 频率：每小时一次。太低会堆积，太高浪费子请求配额。
  "triggers": {
    "crons": ["0 * * * *"],
  },

  // ===========================================================================
  // 存储绑定（KV）
  // ===========================================================================
  //
  // ★ 这里**故意保持注释** —— 你不需要填任何 id。
  //
  //   去掉注释并省略 id 后，wrangler 会自动"预配"：首次部署创建
  //   `<worker名>-kv` 命名空间并绑定；再次部署通过服务端 inherit 复用。
  //
  //   为什么不在本模板里直接启用？因为 `id` 必须留空（写 "id": "" 会被
  //   wrangler 校验拒绝：「should have a string id field」），而未填 id 的
  //   配置在【已有 KV】的账号上可能被误判。**最稳妥的做法是留注释**，
  //   让 wrangler 走自动预配，或者你手动填上自己在控制台建的 KV id。
  //
  // 二选一：
  //   (a) 打开下面这行、删掉 id —— 交给 wrangler 自动创建（推荐新手）
  //   (b) 自己在控制台建好 KV，把真实 id 填进来（推荐老手，可控）
  //
  // "kv_namespaces": [{ "binding": "KV" }],
  //
  // ⚠️ 重要：一旦启用，务必确认这里指向的 KV 与线上数据一致。
  //    填错 id 会读到一个空 KV，表现为「配置全丢 + 139 路径索引失效
  //    → 每次逐层请求上游 → 子请求配额耗尽 → WebDAV/PROPFIND 间歇 503」，
  //    而且刷新一下又能用（换了边缘实例），极难排查。

  // ===========================================================================
  // 静态资源 + Worker 入口的优先级（**关键配置，缺了会出线上故障**）
  // ===========================================================================
  //
  // ## 为什么必须写 run_worker_first
  //
  // 启用 `assets` 后，CF 默认行为是：**先查静态资源，命中就直接返回，
  // 不命中才交给 Worker**。再叠加 SPA 的 index.html 兜底，会出现极隐蔽的故障：
  //
  //   - `GET /`、`/robots.txt`、`/favicon.ico` → 正常（静态资源命中）
  //   - `GET /api/public/settings`、`POST /api/auth/login`
  //     → **完全无响应**，客户端 20~95 秒超时（http=000，ttfb=0）
  //
  // 症状极具误导性：TCP 能连上（connect≈0.18s）但响应头永不到达；
  // `wrangler tail` 里一条日志都没有（说明请求根本没进 Worker）；
  // 回滚版本、清缓存、换 TLS 版本**全都无效**。
  //
  // 用 `run_worker_first` 把动态路径**显式交给 Worker**，静态资源只服务剩余
  // 路径，两类请求互不干扰。**这一段请不要删。**
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/d/*",
      "/sd/*",
      "/p/*",
      "/dav/*",
      "/s3/*",
      "/kv-*"
    ]
  },

  // ===========================================================================
  // 普通环境变量（非敏感）
  // 注意：vars 会在每次 wrangler deploy 时被本文件覆盖（Secrets 不会）。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",

    // 数据存储格式：
    //   map（默认）- 整对象序列化为单个 JSON 键值，适合 KV/Blob
    //   key        - 分 key 存储，每实体一条记录（如 users_1）
    //   sql        - 关系表格式，与 Go 后端一致（适用于 D1/MySQL）
    "DB_FORMAT": "map",

    // 数据库驱动：
    //   auto（默认）- 自动检测，顺序 mysql → d1 → kv → cfkv → blob → do
    //   kv         - Cloudflare KV binding（需上方 kv_namespaces）
    //   d1         - Cloudflare D1（需下方 d1_databases）
    //   do         - Cloudflare Durable Objects
    //   blob       - 腾讯云 EdgeOne Blob / 阿里云 ESA Blob
    //   cfkv       - Cloudflare KV REST API（需 CF_ACCOUNT / CF_KV_UUID / CF_API_KEY）
    //   mysql      - 外部 MySQL（仅 Node 运行时）
    "DB_DRIVER": "auto",

    // ── 安全鉴权（**务必改用 Secret 配置**，见 .dev.vars.example）─────────
    //
    // JWT 签名密钥（>=16 字符，兼作字段加密与定时任务鉴权）
    // 本地调试可填这里，**生产环境请用 `wrangler secret put JWT_SECRET`**
    // "JWT_SECRET": "",
    //
    // 跳过安装向导，自动以该密码初始化 admin
    // "ADMIN_PASS": "",
    //
    // CORS 白名单（逗号分隔，不设则仅同源）
    // "ALLOW_URLS": "https://yourdomain.com",
  },
}
